/* Claude Code Minimalist — Qt Stylesheet (style.qss) */
/* Strictly follows Design System: 0px radius, 1px borders, Zinc/Slate palette */

* {
    font-family: "Iosevka Nerd Font", "JetBrains Mono", "Cascadia Code", "Consolas", "DejaVu Sans Mono", monospace;
    font-size: 13px;
    border-radius: 0px;
}

QMainWindow, QWidget {
    background-color: #18181b;
    color: #d4d4d8;
    border: none;
}

/* Containers and Frames */
QFrame, QGroupBox {
    background-color: #262624;
    border: 1px solid #3f3f46;
    border-radius: 0px;
    padding: 0px;
}

QSplitter, QStackedWidget {
    border: none;
    background: transparent;
    padding: 0px;
    margin: 0px;
}

#sidebar, #verticalTabsPanel, #downloadsDrawer, #notesPanel, #aiPanel {
    background-color: #262624;
    border-right: 1px solid #3f3f46;
}

#rightSidebar {
    background-color: #262624;
    border-left: 1px solid #3f3f46;
}

/* Splitters */
QSplitter::handle {
    background-color: #3f3f46;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

/* Buttons */
QPushButton, QToolButton {
    background-color: #262624;
    color: #d4d4d8;
    border: 1px solid #3f3f46;
    border-radius: 0px;
    padding: 4px 8px;
    min-height: 24px;
    font-family: "Iosevka Nerd Font", "JetBrains Mono", monospace;
    font-size: 12px;
}

QPushButton:hover, QToolButton:hover {
    background-color: #2d2d2a;
    border-color: #94a3b8;
    color: #f5f5f0;
}

QPushButton:pressed, QToolButton:pressed {
    background-color: #18181b;
    border-color: #a855f7;
    color: #f5f5f0;
}

QPushButton:disabled, QToolButton:disabled {
    background-color: #18181b;
    color: #71717a;
    border-color: #2b2b29;
}

/* Accent Buttons */
QPushButton#accentBtn {
    background-color: transparent;
    border: 1px solid #3f3f46;
    border-bottom: 2px solid #a855f7;
    color: #f5f5f0;
    font-weight: bold;
}

QPushButton#accentBtn:hover {
    background-color: #2d2d2a;
    border: 1px solid #3f3f46;
    border-bottom: 2px solid #a855f7;
    color: #a855f7;
}

QPushButton#accentWarmBtn {
    background-color: transparent;
    border: 1px solid #a855f7;
    color: #a855f7;
    font-weight: bold;
}

QPushButton#accentWarmBtn:hover {
    background-color: #2d2d2a;
    border: 1px solid #a855f7;
    color: #a855f7;
}

/* Inputs & Text Edits */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #18181b;
    border: 1px solid #3f3f46;
    border-radius: 0px;
    color: #d4d4d8;
    padding: 5px 8px;
    selection-background-color: #2d2d2a;
    selection-color: #f5f5f0;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #94a3b8;
    background-color: #18181b;
}

QLineEdit::placeholder {
    color: #71717a;
}

/* Vertical Tab List Items */
QListWidget {
    background-color: #262624;
    border: none;
    outline: none;
}

QListWidget#verticalTabsList::item {
    background-color: #262624;
    color: #d4d4d8;
    border-bottom: 1px solid #2b2b29;
    padding: 0px;
    margin: 0px;
    min-height: 36px;
    height: 36px;
}

QListWidget#verticalTabsList::item:hover {
    background-color: #2d2d2a;
    color: #f5f5f0;
    border-left: 2px solid #71717a;
}

QListWidget#verticalTabsList::item:selected {
    background-color: #18181b;
    color: #f5f5f0;
    border-left: 2px solid #a855f7;
    border-right: none;
}

/* Status Bar */
QStatusBar {
    background-color: #18181b;
    color: #71717a;
    border-top: 1px solid #3f3f46;
    min-height: 24px;
    font-size: 11px;
}

QStatusBar QLabel {
    color: #71717a;
    padding: 0 4px;
}

/* Progress Bar */
QProgressBar {
    background-color: #18181b;
    border: 1px solid #3f3f46;
    border-radius: 0px;
    text-align: center;
    color: #d4d4d8;
    font-size: 10px;
    height: 12px;
}

QProgressBar::chunk {
    background-color: #94a3b8;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #18181b;
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #3f3f46;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #18181b;
    height: 6px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #3f3f46;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Popups and Menus */
QMenu {
    background-color: #262624;
    border: 1px solid #3f3f46;
    padding: 4px 0px;
}

QMenu::item {
    background-color: transparent;
    color: #d4d4d8;
    padding: 6px 16px;
}

QMenu::item:selected {
    background-color: #2d2d2a;
    color: #f5f5f0;
}

QMenu::separator {
    height: 1px;
    background-color: #3f3f46;
    margin: 4px 0px;
}

/* Tooltips */
QToolTip {
    background-color: #262624;
    color: #f5f5f0;
    border: 1px solid #94a3b8;
    padding: 4px 8px;
    font-size: 11px;
}

/* Horizontal Tab Bar Close Button Protection */
QTabBar::close-button {
    image: none;
    background: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
    margin: 0px;
    width: 0px;
    height: 0px;
}

